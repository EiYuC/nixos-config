#!/bin/sh

battery_capacity=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n 1)
battery_status=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n 1)

if [ -z "$battery_capacity" ]; then
    printf 'BAT: n/a\n'
    exit 0
fi

case "$battery_status" in
    Charging) printf 'BAT %s%% +\n\n#86efac\n' "$battery_capacity" ;;
    Full) printf 'BAT %s%% full\n\n#86efac\n' "$battery_capacity" ;;
    *)
        if [ "$battery_capacity" -le 20 ]; then
            printf 'BAT %s%%\n\n#fca5a5\n' "$battery_capacity"
        else
            printf 'BAT %s%%\n\n#cbd5e1\n' "$battery_capacity"
        fi
        ;;
esac
