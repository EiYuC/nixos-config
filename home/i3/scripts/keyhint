#!/bin/sh
printf '%s\n' 'Alt+Enter  Terminal' 'Alt+D  Applications' 'Alt+Shift+Q  Close window' 'Alt+H/J/K/L  Focus' 'Alt+Shift+H/J/K/L  Move window' 'Alt+1..0  Workspace' 'Alt+Shift+1..0  Move to workspace' 'Alt+F  Fullscreen' 'Alt+R  Resize mode' 'Alt+Ctrl+L  Lock' 'Alt+Shift+E  Session menu' | rofi -dmenu -i -p Shortcuts -theme ~/.config/rofi/configs/rofikeyhint.rasi
